<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamixel_interface</name>
  <version>0.0.0</version>
  <description>ROS2 driver for Dynamixel servo motors. Publishes joint positions/velocities, subscribes to torque/position commands.</description>
  <maintainer email="lorenzo.vignoli0405@gmail.com">vigno0405</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>dynamixel_sdk</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
